Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "z_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["z", 
     RowBox[{"2", "m"}]], 
    FractionBox[
     RowBox[{"z", "-", "1"}], 
     RowBox[{"z", "+", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "[", "z_", "]"}], "=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], "2"]}], 
    SuperscriptBox["z", 
     RowBox[{
      RowBox[{"2", "m"}], "+", "2"}]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", "z_", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}], 
      RowBox[{"\[Eta]", "[", "z", "]"}]}], ",", 
     RowBox[{"\[ImaginaryI]", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}], 
      RowBox[{"\[Eta]", "[", "z", "]"}]}], ",", 
     RowBox[{"2", 
      RowBox[{"g", "[", "z", "]"}], 
      RowBox[{"\[Eta]", "[", "z", "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "w", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"w", ",", "\[ImaginaryI]", ",", "z"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
