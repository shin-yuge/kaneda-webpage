 CellChangeTimes->{{3.803773841431963*^9, 3.8037738463090296`*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"e6441165-500f-4e21-9817-4053d1648431"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "z_", "]"}], "=", 
   RowBox[{
    SqrtBox["r"], 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], 
      SqrtBox["z"], 
      SqrtBox[
       RowBox[{"z", "-", 
        FractionBox["1", "r"]}]]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "-", "1"}], ")"}], 
      SqrtBox[
       RowBox[{"z", "+", "r"}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "[", "z_", "]"}], "=", 
   RowBox[{"\[ImaginaryI]", " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "-", "1"}], ")"}], "2"], 
      SqrtBox[
       RowBox[{"z", "+", "r"}]]}], 
     RowBox[{
      SuperscriptBox["z", "2"], 
      SqrtBox["z"], 
      SqrtBox[
       RowBox[{"z", "-", 
        FractionBox["1", "r"]}]]}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8007971972091036`*^9, 3.8007972991477003`*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"cd0ff8c8-16ed-4537-afef-f6df964412c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}], ",", 
       RowBox[{"\[ImaginaryI]", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}]}], ",", 
       RowBox[{"2", 
        RowBox[{"g", "[", "z", "]"}]}]}], "}"}], 
     RowBox[{"\[Eta]", "[", "z", "]"}]}]}], ";"}], 
  RowBox[{"(*", 
