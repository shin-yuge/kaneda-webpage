Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "z_", "]"}], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "-", "r"}], ")"}], 
      FractionBox[
       RowBox[{"k", "-", "1"}], "k"]], 
     RowBox[{
      SuperscriptBox["z", 
       FractionBox["1", "k"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", " ", "z"}], " ", "+", "1"}], ")"}], 
       FractionBox[
        RowBox[{"k", "-", "1"}], "k"]]}]], 
    FractionBox[
     RowBox[{"z", "-", "1"}], 
     RowBox[{"z", "+", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "[", "z_", "]"}], "=", 
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"z", "+", "1"}], ")"}], "2"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", " ", "z"}], " ", "+", "1"}], ")"}], 
      FractionBox[
       RowBox[{"k", "-", "1"}], "k"]], 
     RowBox[{
      SuperscriptBox["z", 
       FractionBox[
        RowBox[{
         RowBox[{"2", "k"}], "-", "1"}], "k"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "-", "r"}], ")"}], 
       FractionBox[
        RowBox[{"k", "-", "1"}], "k"]]}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8007971972091036`*^9, 3.8007972991477003`*^9}, {
  3.8041845754973965`*^9, 3.8041846573425217`*^9}, {3.8041857835541825`*^9, 
