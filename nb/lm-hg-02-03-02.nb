Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"p1", "[", "r_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", "r", "]"}], 
     RowBox[{"2", "-", 
      FractionBox["2", "k"]}]], " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"a0", "+", 
        RowBox[{"a1", " ", "r", " ", "t"}]}], 
       RowBox[{"r", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{"1", "-", "t"}], ")"}]}], 
           RowBox[{
            RowBox[{
             SuperscriptBox["r", "2"], "t"}], "+", "1"}]], ")"}], 
         FractionBox["1", "k"]]}]], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "[", "r_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", "r", "]"}], 
     RowBox[{
      FractionBox["2", "k"], "-", "2"}]], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a0", " ", "r"}], "-", 
        RowBox[{"a1", " ", "t"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"t", 
           RowBox[{"(", 
            RowBox[{"t", "+", 
             SuperscriptBox["r", "2"]}], ")"}]}], 
          RowBox[{"1", "-", "t"}]], ")"}], 
        FractionBox["1", "k"]]], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8015642470279036`*^9, 3.8015643130253515`*^9}, {
