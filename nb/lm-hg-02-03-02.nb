Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}], ",", 
       RowBox[{"\[ImaginaryI]", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}]}], ",", 
       RowBox[{"2", 
        RowBox[{"g", "[", "z", "]"}]}]}], "}"}], 
     RowBox[{"\[Eta]", "[", "z", "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"ends", " ", "z"}], "=", "0"}], ",", "\[Infinity]"}], 
   "*)"}]}]], "Input",
