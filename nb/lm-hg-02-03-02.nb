Cell[BoxData[{
 RowBox[{
  RowBox[{"a0", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"3", "k"}], "-", "2", "-", 
     SuperscriptBox["k", "2"], "+", 
     RowBox[{"2", "r"}], "-", 
     RowBox[{"2", 
      SuperscriptBox["k", "2"], "r"}], "-", 
     RowBox[{"k", " ", 
      SuperscriptBox["r", "2"]}], "-", 
     RowBox[{
      SuperscriptBox["k", "2"], 
      SuperscriptBox["r", "2"]}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"k", "+", "1"}], ")"}], "r"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a1", "=", 
   FractionBox[
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "k"}], "-", "1"}], ")"}]}], 
    RowBox[{"k", "+", "1"}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8053865303491096`*^9, 3.805386550019603*^9}, {
